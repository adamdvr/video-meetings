# Параметры docker-compose (PostgreSQL). Скопируйте в .env, чтобы переопределить значения по умолчанию.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# API (apps/api). Хост и порт в DATABASE_URL должны совпадать с POSTGRES_* выше.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings
# Секрет подписи JWT. В production задайте длинную случайную строку.
JWT_SECRET=dev-only-change-me
# Время жизни JWT в секундах (по умолчанию 7 суток).
# JWT_EXPIRES_IN_SECONDS=604800
# Каталог, где api хранит файлы встреч (по умолчанию apps/api/storage).
# FILES_DIR=/var/lib/video-meetings/files
